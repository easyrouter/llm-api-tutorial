{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SeedRouter Onboarding",
  "version": "0.1.0-test.3",
  "identifier": "com.seedrouter.onboarding",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SeedRouter Onboarding",
        "label": "main",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "SeedRouter",
    "targets": ["nsis", "dmg", "app"],
    "createUpdaterArtifacts": false,
    "resources": [
      "resources/app-config.json",
      "resources/docs/**/*",
      "resources/codex-fast-ui/*.zip"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
