{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: open external links, native dialogs, clipboard write, logging.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-save",
    "dialog:allow-message",
    "clipboard-manager:allow-write-text",
    "log:default"
  ]
}
