{
  "$comment": "Company preset shipped with the app. Values marked TODO must be confirmed by IT before pilot (see docs/OPEN_QUESTIONS.md). A user-level override at <app-config-dir>/app-config.json is merged on top at startup.",
  "schemaVersion": 1,
  "company": {
    "name": "Company",
    "supportContact": "it-support@example.com"
  },
  "gateway": {
    "$comment": "baseUrl is the only company-wide constant; model / reasoning effort are the PM defaults (2026-08-16 Codex template) and stay user-editable.",
    "baseUrl": "https://seedrouter.net/v1",
    "protocol": "responses",
    "presetProviderName": "SeedRouter",
    "defaultModel": "gpt-5.6-sol",
    "defaultReasoningEffort": "medium"
  },
  "tools": [
    {
      "id": "codex",
      "displayName": "Codex CLI",
      "npmPackage": "@openai/codex",
      "binary": "codex",
      "versionArgs": ["--version"],
      "configDir": "~/.codex"
    },
    {
      "id": "claude-code",
      "displayName": "Claude Code",
      "npmPackage": "@anthropic-ai/claude-code",
      "binary": "claude",
      "versionArgs": ["--version"],
      "configDir": "~/.claude"
    }
  ],
  "ccSwitch": {
    "$comment": "TODO(IT): confirm intranet mirror + pinned version/hashes for offline distribution.",
    "githubRepo": "farion1231/cc-switch",
    "releasesApi": "https://api.github.com/repos/farion1231/cc-switch/releases/latest",
    "downloadPage": "https://github.com/farion1231/cc-switch/releases/latest",
    "intranetMirror": "",
    "dataDir": "~/.cc-switch"
  },
  "codexApp": {
    "$comment": "Codex desktop client (part of the ChatGPT desktop app since 2026-07). Windows: Microsoft Store (product id) or the Store-signed offline MSIX; macOS: official DMG. Stable links per OpenAI's enterprise deployment docs.",
    "storeProductId": "9PLM9XGG6VKS",
    "windowsMsixX64": "https://persistent.oaistatic.com/codex-app-prod/ChatGPT-x64.msix",
    "windowsMsixArm64": "https://persistent.oaistatic.com/codex-app-prod/ChatGPT-arm64.msix",
    "macosDmg": "https://persistent.oaistatic.com/codex-app-prod/ChatGPT.dmg",
    "downloadPage": "https://chatgpt.com/download/"
  },
  "requirements": {
    "nodeMinVersion": "18.0.0",
    "nodeRecommendedLts": "22",
    "os": {
      "windows": { "minBuild": 19041, "label": "Windows 10 2004+" },
      "macos": { "minVersion": "12.0", "label": "macOS 12 Monterey+" }
    }
  },
  "mirrors": {
    "npmRegistries": [
      { "id": "official", "url": "https://registry.npmjs.org/" },
      { "id": "npmmirror", "url": "https://registry.npmmirror.com/" }
    ],
    "nodeDist": [
      {
        "id": "official",
        "url": "https://nodejs.org/dist/",
        "downloadPage": "https://nodejs.org/en/download"
      },
      {
        "id": "npmmirror",
        "url": "https://npmmirror.com/mirrors/node/",
        "downloadPage": "https://npmmirror.com/mirrors/node/"
      }
    ],
    "probeTimeoutMs": 4000
  },
  "envVarsToInspect": [
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "OPENAI_API_BASE",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_BASE_URL",
    "ANTHROPIC_AUTH_TOKEN",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "ALL_PROXY",
    "NO_PROXY"
  ],
  "docs": {
    "$comment": "TODO(IT #18): the designated documentation site. index.json lists sections {id,title,path,wizardStep}.",
    "baseUrl": "https://docs.example.com/seedrouter-onboarding",
    "indexPath": "index.json",
    "cacheTtlSeconds": 3600
  },
  "telemetry": {
    "$comment": "TODO(IT #16): intranet endpoint + approval. Disabled until endpoint is set. Payload schema in docs/ARCHITECTURE.md; never contains keys, credentials, or file contents.",
    "enabled": false,
    "endpoint": "",
    "flushIntervalSeconds": 30
  }
}
